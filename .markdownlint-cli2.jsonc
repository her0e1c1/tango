{
  "globs": [
    "**/*.md",
    "!node_modules/**",
    "!.worktrees/**"
  ],
  "config": {
    "MD013": false,
    "MD033": false,
    "MD034": false
  },
  "overrides": [
    {
      "filter": [
        "docs/adr/*.md"
      ],
      "config": {
        "MD041": false
      },
      "combine": "merge"
    }
  ]
}
