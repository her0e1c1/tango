{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignoreBinaries": [
    // `wait` is a POSIX shell builtin used by start:all, not a package binary.
    "wait"
  ],
  "ignoreUnresolved": [
    // Vite resolves this browser-only absolute module path during Playwright E2E tests.
    "/src/action/event.ts"
  ]
}
