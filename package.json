{
  "name": "tango-web",
  "version": "2.1.0",
  "private": true,
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "vite dev",
    "build": "vite build",
    "build:sample": "docker compose -f sample/docker-compose.yml run --rm --remove-orphans --entrypoint 'python generate.py ./test -o build/output.json' base",
    "build:storybook": "storybook build",
    "ci": "npm run build:sample && npm run build && npm run build:storybook && npm run fmt && npm run fmt:sample && npm run lint && npm run test:coverage:ci && npm run test:sample",
    "db": "firebase emulators:start",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test": "npm run test:unit",
    "test:coverage": "vitest run --project=unit --coverage --no-file-parallelism",
    "test:coverage:ci": "docker compose -f .devcontainer/compose.yaml -f .devcontainer/compose.local.yaml up --wait --wait-timeout 120 --remove-orphans -d db && npm run test:coverage",
    "test:unit": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration --no-file-parallelism",
    "test:sample": "docker compose -f sample/docker-compose.yml run --rm --remove-orphans --entrypoint py.test base",
    "test:storybook": "vitest run --project=storybook",
    "fix": "npm run fmt:fix && npm run lint:fix",
    "fmt": "biome format ./src ./test ./.storybook && biome lint --error-on-warnings . && npm run lint:markdown",
    "fmt:fix": "biome format --write ./src ./test ./.storybook && biome lint --write . && npm run fmt:markdown",
    "fmt:markdown": "markdownlint-cli2 --fix",
    "fmt:sample": "docker compose -f sample/docker-compose.yml run --rm --remove-orphans --entrypoint 'ruff format --check' base",
    "fmt:sample:fix": "docker compose -f sample/docker-compose.yml run --rm --remove-orphans --entrypoint 'ruff format' base",
    "lint": "npm run lint:tsc && npm run lint:eslint && npm run lint:biome && npm run lint:fsd && npm run lint:knip && npm run lint:markdown",
    "lint:biome": "biome lint --error-on-warnings .",
    "lint:eslint": "eslint --max-warnings=0 'src/**/*.{ts,tsx}'",
    "lint:fsd": "steiger ./src",
    "lint:fix": "eslint --fix 'src/**/*.{ts,tsx}' && biome lint --write . && npm run fmt:markdown",
    "lint:knip": "knip && knip --production --strict",
    "lint:markdown": "markdownlint-cli2",
    "lint:tsc": "tsc",
    "storybook": "storybook dev"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.24",
    "@types/papaparse": "^5.5.2",
    "classnames": "^2.3.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.17.0",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "lodash": "^4.18.1",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-swipeable": "^7.0.2",
    "react-use": "^17.6.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sass": "^1.101.0",
    "vite": "^8.1.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "2.5.7",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "*",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.7.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "firebase-tools": "^15.22.4",
    "jsdom": "^29.1.1",
    "knip": "^6.32.1",
    "markdownlint-cli2": "^0.23.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "postcss": "^8.5.26",
    "steiger": "^0.6.0",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "uuid": "^14.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
