{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Keep the existing lint scope intact; TSX gains only the Cognitive Complexity rule.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": ["**/*.tsx", "!**/*.spec.tsx"]
  },
  "linter": {
    "rules": {
      "preset": "none",
      "complexity": {
        "noExcessiveCognitiveComplexity": "error"
      }
    }
  }
}
