rules_version = '2';
service cloud.firestore {
  function isSignedIn() {
    return request.auth != null &&
           request.auth.token.firebase.sign_in_provider != "anonymous";
  }
  function isOwner() {
    return request.auth.uid == resource.data.uid;
  }
  function isValidOwner() {
    return request.auth.uid == resource.data.uid &&
           request.auth.uid == request.resource.data.uid;
  }
  function isValid() {
    return request.auth.uid == request.resource.data.uid;
  }
  match /databases/{database}/documents {
    match /studySession/{sessionId} {
      allow read: if isSignedIn() && isOwner();
      allow create: if isSignedIn() && isValid() &&
        request.resource.data.currentIndex == 0 && request.resource.data.endReason == null;
      allow update: if isSignedIn() && isValidOwner() && resource.data.endReason == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentIndex', 'endedAt', 'endReason', 'updatedAt']) &&
        request.resource.data.currentIndex is int &&
        request.resource.data.currentIndex >= resource.data.currentIndex &&
        request.resource.data.currentIndex < resource.data.cardOrderIds.size();
    }
    match /studyAnswer/{answerId} {
      function validAnswer(data) {
        let session = get(/databases/$(database)/documents/studySession/$(data.sessionId)).data;
        return data.keys().hasOnly(['uid', 'sessionId', 'deckId', 'cardId', 'answer', 'answeredAt', 'createdAt', 'updatedAt']) &&
          data.answer.keys().hasOnly(['type', 'rating']) && data.answer.type == 'rating' &&
          data.answer.rating in ['again', 'hard', 'good', 'easy'] &&
          data.answeredAt is timestamp && data.createdAt == request.time && data.updatedAt == request.time &&
          session.uid == request.auth.uid && session.deckId == data.deckId &&
          session.endReason == null && session.cardOrderIds[session.currentIndex] == data.cardId;
      }
      allow read: if isSignedIn() && isOwner();
      allow create: if isSignedIn() && isValid() && validAnswer(request.resource.data);
    }
    match /deck/{deckId} {
      function isPublic() {
        return resource.data.isPublic == true;
      }
      allow read: if isOwner() || isPublic();
      allow create: if isSignedIn() && isValid();
      allow update: if isSignedIn() && isValidOwner();
      allow delete: if isSignedIn() && isOwner();
    }
    match /card/{cardId} {
      function getDeck(deckId) {
        return get(/databases/$(database)/documents/deck/$(deckId));
      }
      function isPublic() {
        return getDeck(resource.data.deckId).data.isPublic == true;
      }
      function belongsToDeck() {
        return getDeck(request.resource.data.deckId).data.uid == request.auth.uid
      }
      allow read: if isOwner() || isPublic();
      allow create: if isSignedIn() && isValid() && belongsToDeck();
      allow update: if isSignedIn() && isValidOwner() && belongsToDeck();
      allow delete: if isSignedIn() && isOwner();
    }
  }
}
