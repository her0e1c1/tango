rules_version = '2';
service cloud.firestore {
  function isSignedIn() {
    return request.auth != null &&
           request.auth.token.firebase.sign_in_provider != "anonymous";
  }
  function isOwner() {
    return request.auth.uid == resource.data.uid;
  }
  function isValidOwner() {
    return request.auth.uid == resource.data.uid &&
           request.auth.uid == request.resource.data.uid;
  }
  function isValid() {
    return request.auth.uid == request.resource.data.uid;
  }
  match /databases/{database}/documents {
    match /cardStudyState/{stateId} {
      function validInstant(value) {
        return value is int && value >= 0 && value <= 253402300799999;
      }
      // Subtracting a value from itself rejects infinity without imposing an FSRS stability cap.
      function validFsrs(value) {
        return value is map &&
               value.keys().hasOnly(['state', 'difficulty', 'stability', 'dueAt', 'lastReviewedAt',
                 'reps', 'lapses', 'learningSteps', 'scheduledDays']) &&
               value.state in ['learning', 'review', 'relearning'] &&
               value.difficulty is number && value.difficulty >= 1 && value.difficulty <= 10 &&
               value.stability is number && value.stability > 0 && value.stability - value.stability == 0 &&
               validInstant(value.dueAt) && validInstant(value.lastReviewedAt) &&
               value.reps is int && value.reps > 0 &&
               value.lapses is int && value.lapses >= 0 && value.lapses <= value.reps &&
               value.learningSteps is int && value.learningSteps >= 0 &&
               value.scheduledDays is number && value.scheduledDays >= 0 && value.scheduledDays <= 36500;
      }
      function validState() {
        let state = request.resource.data;
        return state.keys().hasOnly(['schemaVersion', 'uid', 'cardId', 'deckId', 'fsrs', 'createdAt', 'updatedAt']) &&
               state.schemaVersion == 1 && state.cardId is string && state.cardId.size() > 0 &&
               state.deckId is string && state.deckId.size() > 0 &&
               stateId == string(state.uid.size()) + ':' + state.uid + state.cardId &&
               validInstant(state.createdAt) && validInstant(state.updatedAt) &&
               (state.fsrs == null || validFsrs(state.fsrs));
      }
      function ownsCard() {
        let card = get(/databases/$(database)/documents/card/$(request.resource.data.cardId)).data;
        return card.uid == request.auth.uid && card.deckId == request.resource.data.deckId &&
               get(/databases/$(database)/documents/deck/$(card.deckId)).data.uid == request.auth.uid &&
               card.get('deletedAt', null) == null;
      }
      function ownsStateId() {
        let prefix = string(request.auth.uid.size()) + ':' + request.auth.uid;
        return stateId.size() > prefix.size() && stateId[0:prefix.size()] == prefix;
      }
      allow read: if isSignedIn() && isOwner();
      allow create: if isSignedIn() && isValid() && validState() && ownsCard();
      allow update: if isSignedIn() && isValidOwner() && validState() && ownsCard() &&
                    request.resource.data.cardId == resource.data.cardId &&
                    request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && ownsStateId() && (resource == null || isOwner());
    }
    match /studySession/{sessionId} {
      allow read: if isSignedIn() && isOwner();
      allow create: if isSignedIn() && isValid();
      allow update: if isSignedIn() && isValidOwner();
    }
    match /studyAnswer/{answerId} {
      allow read: if isSignedIn() && isOwner();
      allow create: if isSignedIn() && isValid();
    }
    match /deck/{deckId} {
      function isPublic() {
        return resource.data.isPublic == true && resource.data.get('deletedAt', null) == null;
      }
      allow read: if isOwner() || isPublic();
      allow create: if isSignedIn() && isValid();
      allow update: if isSignedIn() && isValidOwner();
      allow delete: if isSignedIn() && isOwner();
    }
    match /card/{cardId} {
      function getDeck(deckId) {
        return get(/databases/$(database)/documents/deck/$(deckId));
      }
      function isPublic() {
        let deck = getDeck(resource.data.deckId).data;
        return deck.isPublic == true && deck.get('deletedAt', null) == null &&
               resource.data.get('deletedAt', null) == null;
      }
      function belongsToDeck() {
        return getAfter(/databases/$(database)/documents/deck/$(request.resource.data.deckId)).data.uid == request.auth.uid;
      }
      function contentOnly() {
        return request.resource.data.keys().hasOnly(['id', 'uid', 'deckId', 'frontText', 'backText', 'tags',
          'uniqueKey', 'createdAt', 'updatedAt', 'deletedAt', 'url', 'startLine', 'endLine']);
      }
      allow read: if isOwner() || isPublic();
      allow create: if isSignedIn() && isValid() && belongsToDeck() && contentOnly();
      allow update: if isSignedIn() && isValidOwner() && belongsToDeck() && contentOnly();
      allow delete: if isSignedIn() && isOwner();
    }
  }
}
