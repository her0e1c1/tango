service cloud.firestore {
  function isOwner() {
    return request.auth.uid == resource.data.uid;
  }
  function isValidOwner() {
    return request.auth.uid == resource.data.uid &&
           request.auth.uid == request.resource.data.uid;
  }
  function isValid() {
    return request.auth.uid == request.resource.data.uid;
  }
  match /databases/{database}/documents {
    match /deck/{deckId} {
      function hasNoPublicVisibility() {
        return !request.resource.data.keys().hasAny(["isPublic"]);
      }
      function keepsLegacyVisibilityUnchanged() {
        // Existing documents may retain the removed field, but normal owner edits must never add, change, or delete it.
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["isPublic"]);
      }
      allow read: if isOwner();
      allow create: if isValid() && hasNoPublicVisibility();
      allow update: if isValidOwner() && keepsLegacyVisibilityUnchanged();
      allow delete: if isOwner();
    }
    match /card/{cardId} {
      function getDeck(deckId) {
        return get(/databases/$(database)/documents/deck/$(deckId));
      }
      function belongsToDeck() {
        return getDeck(request.resource.data.deckId).data.uid == request.auth.uid
      }
      allow read: if isOwner();
      allow create: if isValid() && belongsToDeck();
      allow update: if isValidOwner() && belongsToDeck();
      allow delete: if isOwner();
    }
  }
}
