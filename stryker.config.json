{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.d.ts",
    "!src/**/*.spec.{ts,tsx}",
    "!src/**/*.stories.{ts,tsx}"
  ],
  "concurrency": 2,
  "incrementalFile": "coverage/mutation/stryker-incremental.json",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 0
  },
  "reporters": ["progress", "clear-text", "html", "json"],
  "htmlReporter": {
    "fileName": "coverage/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/mutation.json"
  },
  "ignorePatterns": ["/.worktrees", "/.pnpm-store", "/coverage", "/build", "/storybook-static", "/test-results", "/playwright-report"]
}
